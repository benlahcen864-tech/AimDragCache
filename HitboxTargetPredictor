using UnityEngine;

namespace AimDragCache
{
    public class HitboxTargetPredictor : MonoBehaviour
    {
        private CapsuleCollider targetCollider;
        private Vector3 lastPosition;
        public Vector3 Velocity { get; private set; }

        void Start()
        {
            targetCollider = GetComponent<CapsuleCollider>();
            lastPosition = transform.position;
        }

        void Update()
        {
            Velocity = (transform.position - lastPosition) / Time.deltaTime;
            lastPosition = transform.position;
        }

        public Vector3 GetPredictedCenter(float leadTime)
        {
            if (targetCollider == null) return transform.position;
            Vector3 worldCenter = transform.TransformPoint(targetCollider.center);
            return worldCenter + (Velocity * leadTime);
        }
    }
}
